<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@+id/extraKeyEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Key" />
    <Spinner android:id="@+id/extraTypeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/extraValueEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Value" />
    <CheckBox
        android:id="@+id/extraUseQueryCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/intent_use_input_as_value"
        android:paddingTop="8dp" />
</LinearLayout>